# GymOS production environment
# Set these values in your hosting provider's encrypted environment-variable dashboard.

NODE_ENV=production
PORT=10000

# PostgreSQL: use a managed production database with TLS enabled.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/gymos_saas?schema=public&sslmode=require

# MongoDB Atlas: use a least-privilege database user and allow only your host's outbound IPs.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=gymos
SAAS_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
SAAS_PLATFORM_DB=gymos_platform
SAAS_TENANT_DB_PREFIX=gymos

# Production URL and CORS. Replace with your deployed domain.
APP_BASE_DOMAIN=gymos.example.com
SAAS_CORS_ORIGIN=https://gymos.example.com
VITE_SAAS_API_URL=/api/v1
VITE_AUTH_LOGIN_URL=https://gymos.example.com/local-login

# Generate independent, high-entropy values for every secret below.
AUTH_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
SESSION_JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
QR_CHECKIN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30
QR_CHECKIN_TOKEN_MINUTES=5
BCRYPT_ROUNDS=12
TRIAL_DAYS=30
BASIC_MEMBER_LIMIT=100

# Configure cloud object storage before enabling production member-photo uploads.
# Do not rely on the container's local uploads directory; it is not durable.
