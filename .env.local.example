# ============================================================
# GymOS Local Development Environment
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas (your new cluster)
MONGODB_URI=mongodb+srv://mostafaahmed00q_db_user:l9GvDw8RhdV19HOX@cluster0.rcw9kf6.mongodb.net/?appName=Cluster0
MONGODB_DB=gymos

# Auth (legacy TRPC)
AUTH_JWT_SECRET=dev-auth-jwt-secret-local
SESSION_JWT_SECRET=dev-session-secret-local
OWNER_AUTH_ID=
DEV_LOGIN_EMAIL=
DEV_LOGIN_NAME=
DEV_LOGIN_ROLE=admin

# PostgreSQL - CHANGE THIS to your local PostgreSQL connection
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gymos_saas?schema=public

# SaaS REST API
SAAS_MONGODB_URI=mongodb+srv://mostafaahmed00q_db_user:l9GvDw8RhdV19HOX@cluster0.rcw9kf6.mongodb.net/?appName=Cluster0
SAAS_PLATFORM_DB=gymos_platform
SAAS_TENANT_DB_PREFIX=gymos
SAAS_PORT=4000
SAAS_CORS_ORIGIN=*
APP_BASE_DOMAIN=localhost

# JWT Secrets
JWT_ACCESS_SECRET=dev-jwt-access-secret-gymos-2024
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-gymos-2024
JWT_ACCESS_MINUTES=1440
JWT_REFRESH_DAYS=30
BCRYPT_ROUNDS=10
TRIAL_DAYS=30
BASIC_MEMBER_LIMIT=100

# Client (Vite)
VITE_SAAS_API_URL=
VITE_AUTH_LOGIN_URL=http://localhost:3000/local-login
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPS_PROXY_URL=
